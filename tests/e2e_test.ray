// End-to-end over localhost: full transfer, block delta (only changed blocks
// travel as data), nested dirs, delete, wrong password. One @test (zombie
// listeners between tests).
import std/fs;
import scan;
import server;
import push;

fn temp_dir(prefix: string) -> string {
    match (fs.make_temp_dir(prefix)) {
        Result.Ok(d) => d,
        Result.Err(e) => panic(e),
    }
}

fn symlink(target: string, link: string) {
    match (fs.symlink(target, link)) {
        Result.Ok(_) => { },
        Result.Err(e) => panic(e),
    }
}

fn must_read(path: string) -> string {
    match (fs.read_file(path)) {
        Result.Ok(s) => s,
        Result.Err(e) => panic(e),
    }
}

fn do_push(src: string, port: int, delete: bool) -> push.PushStats {
    match (push.push_once(
        push.PushOpts {
            src: src,
            host: "127.0.0.1",
            port: port,
            password: "secreto",
            delete: delete
        }
    )) {
        Result.Ok(st) => st,
        Result.Err(e) => panic(e),
    }
}

@test
fn sync_end_to_end() {
    let src = temp_dir("raysync_e2e_src_");
    let dst = temp_dir("raysync_e2e_dst_");
    fs.mkdir(src + "/docs");
    fs.write_file(src + "/hola.txt", "hola mundo");
    fs.write_file(src + "/docs/nota.md", "# nota\ncontenido\n");
    var big = "a".repeat(65536) + "b".repeat(65536) + "c".repeat(65536);
    fs.write_file(src + "/big.bin", big);

    // Port 0: the OS picks a free port and start() reports it.
    let port = match (server.start(
        server.ServeOpts { root: dst, bind: "127.0.0.1", port: 0, password: "secreto" }
    )) {
        Result.Ok(p) => p,
        Result.Err(e) => panic(e),
    };

    // First push: everything travels as data.
    let st1 = do_push(src, port, false);
    assert_eq(st1.files_sent, 3);
    assert(st1.data_bytes >= 65536 * 3);
    assert_eq(must_read(dst + "/hola.txt"), "hola mundo");
    assert_eq(must_read(dst + "/docs/nota.md"), "# nota\ncontenido\n");
    assert_eq(must_read(dst + "/big.bin").len(), 65536 * 3);

    // Nothing changed: nothing travels.
    let st2 = do_push(src, port, false);
    assert_eq(st2.files_sent, 0);
    assert_eq(st2.data_bytes, 0);

    // Change ONE block of the big file: only ~64 KiB travels, the rest is
    // reused in place on the receiver.
    var patched = "a".repeat(65536) + "X".repeat(65536) + "c".repeat(65536);
    fs.write_file(src + "/big.bin", patched);
    let st3 = do_push(src, port, false);
    assert_eq(st3.files_sent, 1);
    assert(st3.data_bytes >= 65536);
    assert(st3.data_bytes < 65536 * 2);
    assert(st3.copied_bytes >= 65536 * 2);
    let got = must_read(dst + "/big.bin");
    assert_eq(got.len(), 65536 * 3);
    assert_eq(got.substring(65536, 65537), "X");
    assert_eq(got.substring(0, 1), "a");
    assert_eq(got.substring(131072, 131073), "c");

    // --delete removes receiver files gone from the source.
    fs.remove_file(src + "/hola.txt");
    do_push(src, port, true);
    assert(!fs.exists(dst + "/hola.txt"));
    assert(fs.exists(dst + "/docs/nota.md"));

    // Wrong password: authentication fails, nothing breaks.
    match (push.push_once(
        push.PushOpts {
            src: src,
            host: "127.0.0.1",
            port: port,
            password: "equivocada",
            delete: false
        }
    )) {
        Result.Err(e) => assert(e.contains("authentication") || e.contains("closed")),
        Result.Ok(st) => panic("wrong password must fail"),
    }

    // Containment: a symlink inside the receiver root that points OUTSIDE it
    // is never written through, and --delete never removes through it.
    let outside = temp_dir("raysync_e2e_outside_");
    fs.write_file(outside + "/keep.txt", "not yours");
    symlink(outside, dst + "/escape");
    let evil = temp_dir("raysync_e2e_evil_");
    fs.mkdir(evil + "/escape");
    fs.write_file(evil + "/escape/pwned.txt", "gotcha");
    match (push.push_once(
        push.PushOpts {
            src: evil,
            host: "127.0.0.1",
            port: port,
            password: "secreto",
            delete: true
        }
    )) {
        Result.Err(e) => assert(e.contains("escapes the sync root")),
        Result.Ok(st) => panic("writing through an outside symlink must fail"),
    }
    assert(!fs.exists(outside + "/pwned.txt"));
    assert_eq(must_read(outside + "/keep.txt"), "not yours");

    fs.remove_all(src);
    fs.remove_all(dst);
    fs.remove_all(outside);
    fs.remove_all(evil);
}
